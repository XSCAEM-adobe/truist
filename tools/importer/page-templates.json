          "name": "columns-sidebar",
          "instances": [
            ".tmp__article--body > .aem-Grid > .responsivegrid > .aem-Grid > .gridlayoutcontainer:has(.grid__bg-color--midnight-purple)"
          ]
        },
        {
          "name": "table",
          "instances": [
            ".tmp__article--body table"
          ]
        },
        {
          "name": "cards-article",
          "instances": [
